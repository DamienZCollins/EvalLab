# 复制为 .env 后填写；.env 已被 .gitignore 排除，禁止提交
# 服务端启动前需导出以下变量（与 docker/.env 中的密码保持一致）
EVALLAB_DB_HOST=localhost
EVALLAB_DB_PORT=3306
EVALLAB_DB_NAME=evallab
EVALLAB_DB_USERNAME=root
EVALLAB_DB_PASSWORD=change-me
EVALLAB_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# LLM-as-Judge（OpenAI 兼容端点）；EVALLAB_LLM_BASE_URL 留空即关闭 Judge
EVALLAB_LLM_BASE_URL=
EVALLAB_LLM_API_KEY=
EVALLAB_LLM_MODEL=gpt-4o-mini
