# 复制为 docker/.env 后修改；docker/.env 已被 .gitignore 排除，禁止提交
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=evallab
MYSQL_PORT=3306

# 宿主机端口映射
SERVER_PORT=8080
AGENT_PORT=8081
WEB_PORT=5173

# Agent 侧 TIMEOUT 故障阻塞时长；须小于平台侧超时（90s）
AGENT_TIMEOUT_DELAY=65s

# LLM-as-Judge（OpenAI 兼容端点）；留空即关闭 Judge，评测照常跑确定性评分器。
# 容器内访问宿主机服务用 http://host.docker.internal:端口
EVALLAB_LLM_BASE_URL=
EVALLAB_LLM_API_KEY=
EVALLAB_LLM_MODEL=gpt-4o-mini
